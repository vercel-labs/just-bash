      "expected": {
        "exitCode": 0,
        "stdout": "[\"a\",0,\"x\"]\n[\"b\",2,{}]\n",
        "stderr": ""
      },
      "stdin": ""
    },
    {
      "id": "array",
      "files": {
        "a": "[]",
        "b": "\n{}\n"
      },
      "args": ["-c", "[input_filename,input_line_number,.]", "a", "b"],
      "expected": {
        "exitCode": 0,
        "stdout": "[\"a\",0,[]]\n[\"b\",2,{}]\n",
        "stderr": ""
      },
      "stdin": ""
    },
    {
      "id": "object",
      "files": {
        "a": "{}",
        "b": "\n{}\n"
      },
      "args": ["-c", "[input_filename,input_line_number,.]", "a", "b"],
      "expected": {
        "exitCode": 0,
        "stdout": "[\"a\",0,{}]\n[\"b\",2,{}]\n",
        "stderr": ""
      },
      "stdin": ""
    },
    {
      "id": "next-empty-last",
      "files": {
        "a": "10",
        "b": ""
      },
      "args": ["-c", "[input_filename,input_line_number,.]", "a", "b"],
      "expected": {
        "exitCode": 0,
        "stdout": "[\"b\",0,10]\n",
        "stderr": ""
      },
      "stdin": ""
