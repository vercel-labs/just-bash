{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/cli/just-bash.ts"],
  "project": ["src/**/*.ts"],
  "ignore": [
    "src/**/*.test.ts",
    "src/spec-tests/**",
    "src/banned-patterns-test.ts",
    "src/security/fuzzing/**"
  ],
  "ignoreIssues": {
    "src/wasm/protocol.ts": ["exports"],
    "src/wasm/wasi/abi.ts": ["exports"],
    "src/wasm/wasi/filesystem.ts": ["exports"]
  },
  "ignoreBinaries": ["tsx"],
  "rules": {
    "unlisted": "off",
    "unresolved": "off",
    "optionalPeerDependencies": "off",
    "types": "off"
  }
}
