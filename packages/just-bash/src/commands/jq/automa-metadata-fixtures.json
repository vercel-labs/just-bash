    {
      "id": "next-first-line-with-LF",
      "files": {
        "a": "10",
        "b": " {}\n"
      },
      "args": ["-c", "[input_filename,input_line_number,.]", "a", "b"],
      "expected": {
        "exitCode": 0,
        "stdout": "[\"b\",1,10]\n[\"b\",1,{}]\n",
        "stderr": ""
      },
      "stdin": ""
